# FRAMEWORK:START
# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
.idea/
.vscode/
*.sublime-*

# Claude Code local settings (contains user-specific permissions)
.claude/settings.local.json

# Personal main-session mode override (gitignored on purpose; team-shared
# selection lives in .claude/settings.json "assistantMode"). See
# .claude/modes/README.md.
.claude/mode.local

# Per-fork bootstrap config — consumed by substitute-config-placeholders.sh.
# Keep .gembaflow-config.example.json (template) committed; gitignore the
# actual per-fork file so upstream never ships a fork's substituted values.
.gembaflow-config.json

# Environment and secrets
.env
.env.*
*.key
*.pem
credentials.json
secrets.json

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*

# Next.js
.next/
out/
next-env.d.ts

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build outputs (if applicable)
dist/
build/
coverage/
*.tsbuildinfo

# Logs
*.log
logs/

# Framework-generated artifacts (do not commit)
.gembaflow-reports/
.agile-flow-reports/
.agile-flow-version

# Board projections — read-only HTML regenerated from bd (beads) state by
# .claude/hooks/render-boards-on-bd.sh; never committed, never hand-edited.
# Note: .gembaflow-boards.config.json (repo root) IS committed — only the
# generated output directory is ignored.
.gembaflow-boards/

# beads (bd) tracker — machine-local Dolt runtime under .beads/ is never
# committed. Committed tracker files (durable, mergeable): .beads/config.yaml,
# .beads/issues.jsonl (auto-export mirror), .beads/metadata.json,
# .beads/interactions.jsonl. bd also writes its own committed
# .beads/.gitignore; this block mirrors the reference fork's as defense in
# depth. The root-level patterns at the end (.dolt/, *.db,
# .beads-credential-key — plus .beads/proxieddb/ above) match what `bd init`
# would append when absent — shipping them here keeps bd init from editing
# the user area of this file. See docs/BEADS.md.
.beads/dolt/
.beads/embeddeddolt/
.beads/proxieddb/
.beads/backup/
.beads/export-state/
.beads/export-state.json
.beads/daemon.*
.beads/dolt-server.*
.beads/ephemeral.sqlite3*
.beads/*.lock
.beads/.exclusive-lock
.beads/.sync.lock
.beads/bd.sock*
.beads/last-touched
.beads/.local_version
.dolt/
*.db
.beads-credential-key

# Operator-facing Codespaces welcome surface — written on every postCreate
# by scripts/codespace-postcreate.sh; carries any non-blocking-setup warnings.
# Gitignored so it stays per-Codespace and never lands in the repo.
WELCOME.md

# Per-fork MCP server config — generated from .mcp.example.json by
# bootstrap.sh / codespace-postcreate.sh on first install. Keep the example
# committed; gitignore the operator-local copy so fork-specific MCP server
# additions (e.g. supabase, custom servers) don't propagate upstream.
.mcp.json
# FRAMEWORK:END

# Project-specific ignores (add below this line)
