{
  // GitHub Codespace devcontainer — recommended setup path for workshops.
  //
  // Eliminates Windows shell incompatibility, tool-version drift, and
  // env-var propagation gotchas. Works for founders on any platform
  // (Render, Vercel, Railway, etc.) — no cloud-provider lock-in.
  "name": "gembaflow",

  // Lean Ubuntu base — features below add Python / Node / gh.
  // Pinned to noble (24.04 LTS) so the underlying OS doesn't drift.
  "image": "mcr.microsoft.com/devcontainers/base:noble",

  // Tool versions match what the project expects (see CLAUDE.md).
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "latest"
    }
  },

  // Solo mode is the default for Codespaces — no bot accounts, single
  // personal account plays all roles.
  "containerEnv": {
    "GEMBAFLOW_SOLO_MODE": "true"
  },

  // Customizations:
  //   - NO codespaces.repositories permissions block — deliberately (SEC-02,
  //     gembaflow#548). The Codespaces-injected GITHUB_TOKEN falls back to
  //     GitHub's default: scoped to THIS fork only, with the contents/
  //     issues/pull-requests access the normal agent ticket/PR flow needs.
  //     The old block granted `administration:write` + `workflows:write`
  //     under `repositories."*"` (every repo the operator can reach) — an
  //     ambient escalation surface for a prompt-injected agent, and the
  //     source of the first-boot "Approve these permissions?" dialog.
  //     Consequence: /bootstrap Phase 4's ruleset POST cannot succeed on
  //     the default token; the probe-first gate (scripts/lib/
  //     ruleset-probe.sh, gembaflow#520) detects that and prints the calm
  //     upgrade path (scoped PAT per docs/codespaces-secrets.md) instead
  //     of a raw 403. Do NOT re-add `administration` here — the ruleset
  //     POST is its only consumer and it stays behind an explicit
  //     operator-run step.
  //   - vscode.extensions: preinstall Claude Code (provides `claude` CLI and
  //     sidebar UI). Deliberately UNPINNED: the devcontainer `extensions`
  //     field accepts only `publisher.name` or `publisher.name@<exact>` —
  //     a semver range like `@^1` is an invalid version request and the
  //     install silently no-ops (gembaflow#681). Exact pins are rejected
  //     too: the extension tracks the fast-moving claude CLI, and a stale
  //     pin is a worse failure than drift (risk R5, accepted for v1 —
  //     workshop runs are the canary; pin to last-known-good only if one
  //     breaks).
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },

  // Single postCreate orchestrator. Idempotent, non-interactive,
  // fail-tolerant on non-blocking warnings (surfaced via WELCOME.md).
  // Handles: git identity (post-2017 noreply email), local hooksPath,
  // .mcp.json from .mcp.example.json, .gembaflow-version stamp,
  // .gembaflow-config.json (solo_mode default), pinned bd (beads) CLI
  // install + version gate (pin: scripts/lib/bd-version.sh, gate:
  // scripts/check-bd.sh — see docs/BEADS.md), uv sync --extra dev,
  // WELCOME.md write.
  "postCreateCommand": "bash scripts/codespace-postcreate.sh",

  // Next.js dev server (default starter).
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "notify"
    }
  },

  // Cap at 2-core to keep workshop costs predictable.
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
